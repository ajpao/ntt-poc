{
  "hosting": {
    "target": "poc",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "node_modules/**",
      "update-vms.html"
    ],
    "rewrites": [
      { "source": "/", "destination": "/poc.html" }
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
